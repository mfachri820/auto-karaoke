<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/perf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_deep"
    android:clickable="true"
    android:focusable="true">

    <!-- Album art, blurred into a glow behind the lyrics -->
    <ImageView
        android:id="@+id/perf_album_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_perf_scrim" />

    <!-- Now playing, pinned to the top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingTop="40dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/perf_album_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_album_art"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/perf_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_bold"
                android:maxLines="1"
                android:textColor="@color/headlight"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/perf_track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_medium"
                android:maxLines="1"
                android:textColor="@color/dusk"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/perf_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_source_pill"
            android:fontFamily="@font/jakarta_semibold"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/dusk"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Lyrics: previous, current, next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/perf_prev_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_semibold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingBottom="12dp"
            android:textColor="#59F4EFE6"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/perf_current_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="balanced"
            android:fontFamily="@font/jakarta_extrabold"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:lineSpacingMultiplier="1.12"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:textColor="@color/headlight"
            android:textSize="38sp" />

        <!-- Pronunciation (Korean / Japanese) under the current line -->
        <TextView
            android:id="@+id/perf_current_roman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_semibold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="8dp"
            android:textColor="#D9F4EFE6"
            android:textSize="21sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/perf_next_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:paddingStart="36dp"
            android:paddingTop="12dp"
            android:paddingEnd="36dp"
            android:textColor="#8CF4EFE6"
            android:textSize="23sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/perf_exit_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/jakarta_medium"
        android:text="Tap anywhere to close"
        android:textColor="@color/dusk_dim"
        android:textSize="13sp" />

</FrameLayout>
